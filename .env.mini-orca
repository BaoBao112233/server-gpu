# Mini Orca LLM Server với llama.cpp
# Optimized cho Orange Pi RV2 4GB RAM

# Backend Configuration
MODEL_BACKEND=llama-cpp

# Model Configuration
MODEL_PATH=/app/models/mini-orca-small-q4_k_m.gguf

# LLaMA.cpp Settings (Optimized for 4GB RAM)
N_CTX=2048                # Context window (tăng nếu cần, giảm nếu RAM không đủ)
N_THREADS=4               # CPU threads (điều chỉnh theo số core của Orange Pi)
N_GPU_LAYERS=0            # 0 = CPU only (Orange Pi không có GPU mạnh)
MAX_TOKENS=512            # Max tokens per response
MAX_RAM_MB=3072           # Max RAM usage (3GB cho model, để lại RAM cho OS)

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# API Settings (optional)
ENABLE_API_KEY=false
# API_KEY=your-secret-key-here

# Logging
LOG_LEVEL=INFO

# Performance Tuning
# Nếu gặp vấn đề về RAM, giảm N_CTX xuống 1024 hoặc 512
# Nếu inference chậm, tăng N_THREADS lên số core CPU của bạn
